# The general package sdist is separate from the curated Schur paper archive.
# Explicit pruning also removes these paths from a stale SOURCES.txt cache.
prune notes/evals
prune notes/experiments
prune notes/verification
prune notes/client
prune notes/session-logs
prune outputs
prune papers
prune .agents
prune .codex
global-exclude *.so *.pyd *.dll *.dylib *.o *.a *.py[cod]
global-exclude ._* .DS_Store

# These tests intentionally bind to private/check-out-only notes, and one
